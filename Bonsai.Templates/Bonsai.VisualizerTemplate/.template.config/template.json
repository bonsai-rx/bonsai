{
    "$schema": "http://json.schemastore.org/template",
    "author": "Bonsai",
    "classifications": [ "Bonsai", "Visualizer" ],
    "description": "A class used to create a Bonsai type visualizer",
    "identity": "Bonsai.VisualizerTemplate",
    "name": "Bonsai Visualizer",
    "tags": {
        "language": "C#",
        "type": "item"
    },
    "symbols": {
        "itemName": {
            "type": "derived",
            "valueSource": "name",
            "valueTransform": "safe_name",
            "replaces": "$safeitemname$",
            "fileRename": "VisualizerTemplate"
        },
        "namespace": {
            "type": "bind",
            "binding": "msbuild:RootNamespace",
            "replaces": "$rootnamespace$"
        }
    },
    "constraints": {
        "csharp-only": {
            "type": "project-capability",
            "args": "CSharp"
        }
    },
    "postActions": [{
        "actionId": "B17581D1-C5C9-4489-8F0A-004BE667B814",
        "description": "Adds a reference to the Bonsai.Design package.",
        "continueOnError": true,
        "manualInstructions": [{
            "text": "Add a package reference to Bonsai.Design."
        }],
        "args": {
            "referenceType": "package",
            "reference": "Bonsai.Design",
            "version": "2.9.2",
            "projectFileExtensions": ".csproj"
        }
    }],
    "shortName": "bonsaivisualizer",
    "defaultName": "Visualizer1",
    "preferDefaultName": true
}